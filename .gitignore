# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
playwright-report/
test-results/
blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.mcp.json

# local agent / tool config
.claude/
.agents/
.codex/
.vscode/
.playwright-mcp/

# private collaboration instructions and memory
/AGENTS.md
/CLAUDE.md
/Memory.md

# design iterations — 自動截圖 hook 已停用，整個資料夾不進 git
/iterations/

# Crypto Arsenal 案例頁製作暫存（Figma 驗證 render、影片 poster、影片工作檔）— 不進 git，定版後另匯出最終素材
public/projects/*/_staging/

# historical prototypes and raw exports kept outside the public code snapshot
/variants/
public/projects/*/_figma-raw/
public/projects/design-system-case-study/source/

# git worktree directory
/.worktrees/

# 一次性暫存工作區（驗證腳本、debug 產物）— 不進 git
tmp/

# Browser Control 本地執行診斷 — 不進 git
/reports/runs/

# design-sync
.ds-sync/
ds-bundle/
/.design-sync/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# private presentation and brand-film production workspaces
/presentation/
/docs/brand-film/

# internal planning, review, and publication-preparation artifacts
/docs/plans/
/docs/reviews/
/docs/design-system/audit/
