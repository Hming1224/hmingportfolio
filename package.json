{
  "name": "hmingportfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "start:test": "next start -p 3100",
    "lint": "eslint app components data i18n lib proxy.ts next.config.ts",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:i18n": "node scripts/check-i18n.mjs --strict",
    "verify:quick": "git diff --check && npm run lint && npm run check:tokens && npm run check:i18n",
    "verify:build": "npm run verify:quick && npm run build",
    "smoke:ds": "playwright test tests/smoke/design-system.spec.ts --project=chromium",
    "smoke:contact": "playwright test tests/smoke/contact.spec.ts --project=chromium",
    "smoke:regression": "playwright test tests/smoke/regression.spec.ts --project=chromium",
    "smoke:all": "playwright test tests/smoke --project=chromium",
    "verify:ds": "npm run verify:build && npm run smoke:ds",
    "verify:full": "npm run verify:build && npm run smoke:all",
    "prepare": "husky",
    "audit:architecture": "python3 scripts/arch-audit.py",
    "knip": "knip"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@next/third-parties": "^16.2.9",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.4",
    "next-intl": "^4.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "husky": "^9.1.7",
    "knip": "^6.17.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "knip": {
    "ignoreBinaries": [
      "python3"
    ]
  }
}
