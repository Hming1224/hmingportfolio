{
  "hooks": [
    {
      "event": "SessionStart",
      "command": "bash",
      "args": ["../../000_Agent/scripts/session-start.sh"]
    },
    {
      "event": "SessionEnd",
      "command": "node",
      "args": ["../../000_Agent/scripts/journal-autolog.js"]
    },
    {
      "event": "PreCompact",
      "command": "node",
      "args": ["../../000_Agent/scripts/journal-autolog.js"]
    },
    {
      "event": "PreToolUse",
      "command": "node",
      "args": ["../../000_Agent/scripts/iteration-capture.js", "before"],
      "filter": {
        "tool": "replace_file_content"
      }
    },
    {
      "event": "PreToolUse",
      "command": "node",
      "args": ["../../000_Agent/scripts/iteration-capture.js", "before"],
      "filter": {
        "tool": "multi_replace_file_content"
      }
    },
    {
      "event": "PreToolUse",
      "command": "node",
      "args": ["../../000_Agent/scripts/iteration-capture.js", "before"],
      "filter": {
        "tool": "write_to_file"
      }
    },
    {
      "event": "PostToolUse",
      "command": "node",
      "args": ["../../000_Agent/scripts/iteration-capture.js", "after"],
      "filter": {
        "tool": "replace_file_content"
      }
    },
    {
      "event": "PostToolUse",
      "command": "node",
      "args": ["../../000_Agent/scripts/iteration-capture.js", "after"],
      "filter": {
        "tool": "multi_replace_file_content"
      }
    },
    {
      "event": "PostToolUse",
      "command": "node",
      "args": ["../../000_Agent/scripts/iteration-capture.js", "after"],
      "filter": {
        "tool": "write_to_file"
      }
    }
  ]
}
